---
import Logo from "./Logo.astro";
import { mainNav, footerNav } from "../data/navigation";
import { site } from "../data/place";

const year = new Date().getFullYear();

---

<footer class="mt-20 bg-banyan-950 text-sand-100">
  <div class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Logo tone="light" />
      </div>

      <nav aria-label="主要頁面">
        <h2 class="text-sm font-bold tracking-wide text-sand-50">探索古榕</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} class="text-sand-100/80 hover:text-sand-50">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="其他頁面">
        <h2 class="text-sm font-bold tracking-wide text-sand-50">更多資訊</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            footerNav.map((item) => (
              <li>
                <a href={item.href} class="text-sand-100/80 hover:text-sand-50">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-4 border-t border-sand-100/15 pt-6 text-sm text-sand-100/80 md:flex-row md:items-start md:justify-between"
    >
      <div class="space-y-2">
        <p>© {year} {site.name} · 版權所有</p>
        <p>本網站是一個獨立的旅遊資訊項目。我們與任何政府機構或官方組織均無關聯。</p>
      </div>
      <nav aria-label="法律與隱私資訊" class="flex flex-wrap gap-x-5 gap-y-2 md:justify-end md:text-right">
        <a class="hover:text-sand-50" href="/privacy-policy/">隱私政策</a>
        <a class="hover:text-sand-50" href="/terms-of-service/">服務條款</a>
        <a class="hover:text-sand-50" href="/cookie-settings/">Cookie 設定</a>
      </nav>
    </div>
  </div>
</footer>
