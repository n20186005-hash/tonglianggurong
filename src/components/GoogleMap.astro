---
import { place } from "../data/place";
import {
  googleReviews,
  reviewsEntryUrl,
  reviewsSourceNote,
  reviewsButtonLabel,
} from "../data/reviews";

const embedUrl =
  `https://www.google.com/maps?q=${place.coordinates.latitude},` +
  `${place.coordinates.longitude}&z=16&output=embed`;

/** 將 4.4 顯示成兩段：小數點前 + 小數點後 */
const ratingStr = googleReviews.rating.toString();
const [ratingInt, ratingDec] = ratingStr.split(".");
---

<section aria-labelledby="location-title" class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  <div class="mb-6">
    <p class="text-sm font-semibold tracking-wide text-temple-700">位置與導航</p>
    <h2 id="location-title" class="mt-2 text-3xl font-bold text-banyan-900">
      前往通樑古榕
    </h2>
    <p class="mt-3 max-w-2xl text-banyan-800/80">
      開放狀態、即時路況、停車情形與旅客評論可能變動，出發前請查看 Google Maps。
    </p>
  </div>

  <div class="mb-6 flex flex-wrap gap-3">
    <a
      href={place.directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-banyan-900 px-6 py-3 font-semibold text-sand-50 transition-colors hover:bg-banyan-800"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="2"/>
      </svg>
      開始導航
    </a>
    <a
      href={place.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full border border-banyan-900/25 px-6 py-3 font-semibold text-banyan-900 transition-colors hover:bg-sand-100"
    >
      查看地點與評論
    </a>
  </div>

  <div class="overflow-hidden rounded-3xl border border-sand-200 shadow-sm">
    <iframe
      src={embedUrl}
      title="通樑古榕 Tongliang Great Banyan 在 Google Maps 上的位置"
      loading="lazy"
      class="aspect-[4/3] h-full w-full border-0 md:aspect-[16/7]"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>

  <!-- 評價區塊：顯示於頁面，不寫入 JSON-LD aggregateRating -->
  <aside
    aria-labelledby="reviews-title"
    class="mt-8 rounded-2xl border border-sand-200 bg-white p-5 shadow-sm md:p-6"
  >
    <div class="flex flex-col gap-1 md:flex-row md:items-end md:gap-6">
      <h3 id="reviews-title" class="text-base font-bold text-banyan-900">
        谷歌地圖用戶評價
      </h3>
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <!-- 星等數值（純視覺，不進入結構化資料） -->
        <span class="inline-flex items-baseline gap-0.5 leading-none">
          <span class="text-4xl font-extrabold text-banyan-900" aria-hidden="true">
            {ratingInt}
          </span>
          {ratingDec && (
            <span class="text-xl font-bold text-banyan-900" aria-hidden="true">
              .{ratingDec}
            </span>
          )}
          <span class="ml-1 text-sm font-medium text-banyan-800/70" aria-hidden="true">/ 5</span>
        </span>
        <span class="sr-only">
          Google 地圖評分 {googleReviews.rating} 分（滿分 5 分），共 {googleReviews.reviewCount} 則用戶評價。
        </span>
        <!-- 星形圖示 -->
        <span class="inline-flex items-center gap-0.5 text-temple-700" aria-hidden="true">
          {
            Array.from({ length: 5 }).map((_, i) => {
              const v = googleReviews.rating - i;
              const fill = Math.max(0, Math.min(1, v));
              return (
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                  <defs>
                    <linearGradient id={`star-grad-${i}`} x1="0" x2="1" y1="0" y2="0">
                      <stop offset={`${fill * 100}%`} stop-color="currentColor" />
                      <stop offset={`${fill * 100}%`} stop-color="#e7dfcb" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M12 17.3l-6.18 3.7 1.64-7.03L2 9.24l7.19-.62L12 2l2.81 6.62L22 9.24l-5.46 4.73L18.18 21z"
                    fill={`url(#star-grad-${i})`}
                  />
                </svg>
              );
            })
          }
        </span>
        <span class="text-sm font-medium text-banyan-800/80">
          {googleReviews.reviewCount.toLocaleString("zh-TW")} 則評價
        </span>
      </div>
    </div>

    <p class="mt-2 text-xs leading-relaxed text-banyan-800/65">
      評分與評價數同步自谷歌地圖（Google Maps）用戶評價 · {googleReviews.syncMonth} ·
      <a
        href={reviewsEntryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-temple-700"
        >點擊查看谷歌地圖全部評價↗</a
      >
    </p>

    <p class="mt-4 text-sm leading-relaxed text-banyan-800/85">
      {reviewsSourceNote}
    </p>

    <div class="mt-5">
      <a
        href={reviewsEntryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-banyan-900 px-6 py-3 text-sm font-semibold text-sand-50 transition-colors hover:bg-banyan-800"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2 15 8.5 22 9.6 17 14.3 18.3 21 12 17.8 5.7 21 7 14.3 2 9.6 9 8.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        {reviewsButtonLabel}
      </a>
    </div>
  </aside>
</section>