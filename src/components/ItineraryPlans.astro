---
/**
 * 三條針對性路線 + 兩條通用路線
 *
 * 強調「不推薦特定商家」、「不收費導覽」，以科普與現場觀察為主軸
 */

import { itineraries } from "../data/itinerary";

const targeted = itineraries.filter((p) =>
  ["family", "photography", "accessibility"].includes(p.id)
);
const general = itineraries.filter((p) =>
  ["half-day", "full-day"].includes(p.id)
);
---

<section
  aria-labelledby="itinerary-title"
  class="mx-auto max-w-6xl px-4 py-16 md:px-6"
>
  <div class="mb-10 max-w-3xl">
    <p class="text-sm font-semibold tracking-wide text-temple-700">
      按人群定制的遊覽方案
    </p>
    <h2
      id="itinerary-title"
      class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl"
    >
      三條針對性路線＋通用路線
    </h2>
    <p class="mt-3 text-base leading-relaxed text-banyan-800/85">
      依「同行對象」與「可投入時間」挑選路線。本網站不收費導覽，
      所有站點均可由旅客依地圖與說明自行安排。
    </p>
  </div>

  <!-- 三條針對性路線 -->
  <h3 class="text-xl font-bold text-banyan-900">針對性路線</h3>
  <div class="mt-4 grid gap-6 lg:grid-cols-3">
    {
      targeted.map((p) => (
        <article class="rounded-3xl border border-sand-200 bg-white p-6 shadow-sm">
          <div class="flex items-baseline justify-between gap-3">
            <h4 class="text-xl font-bold text-banyan-900">{p.title}</h4>
            <span class="rounded-full bg-temple-100 px-3 py-1 text-xs font-semibold text-temple-700">
              {p.subtitle}
            </span>
          </div>
          <p class="mt-2 text-sm font-semibold text-temple-700">適用對象</p>
          <p class="text-sm text-banyan-800/80">{p.audience}</p>

          <dl class="mt-3 grid grid-cols-3 gap-2 text-xs text-banyan-800/85">
            <div class="rounded-xl bg-sand-100/60 p-2 text-center">
              <dt class="text-banyan-800/60">總時間</dt>
              <dd class="font-semibold">{p.totalDuration}</dd>
            </div>
            <div class="rounded-xl bg-sand-100/60 p-2 text-center">
              <dt class="text-banyan-800/60">距離</dt>
              <dd class="font-semibold">{p.distance}</dd>
            </div>
            <div class="rounded-xl bg-sand-100/60 p-2 text-center">
              <dt class="text-banyan-800/60">體力</dt>
              <dd class="font-semibold">
                <span aria-hidden="true">
                  {"●".repeat(p.effort)}
                  {"○".repeat(5 - p.effort)}
                </span>
              </dd>
            </div>
          </dl>

          <p class="mt-3 text-sm leading-relaxed text-banyan-800/85">
            {p.summary}
          </p>

          <details class="mt-4 group">
            <summary class="cursor-pointer list-none text-sm font-semibold text-temple-700 hover:text-temple-800">
              站點行程 ({p.stops.length} 站)
            </summary>
            <ol class="mt-3 list-none space-y-2 p-0">
              {p.stops.map((s) => (
                <li class="rounded-xl bg-sand-100/50 p-3 text-sm">
                  <p class="flex items-baseline gap-2 font-semibold text-banyan-900">
                    <span class="text-temple-700">{s.n}</span>
                    {s.title}
                    <span class="ml-auto text-xs font-normal text-banyan-800/60">
                      {s.duration} 分
                    </span>
                  </p>
                  <p class="mt-1 text-xs leading-relaxed text-banyan-800/80">
                    {s.description}
                  </p>
                </li>
              ))}
            </ol>
          </details>

          <details class="mt-2 group">
            <summary class="cursor-pointer list-none text-sm font-semibold text-temple-700 hover:text-temple-800">
              貼心提醒
            </summary>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-banyan-800/80 marker:text-leaf-400">
              {p.tips.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </details>
        </article>
      ))
    }
  </div>

  <!-- 通用路線 -->
  <h3 class="mt-12 text-xl font-bold text-banyan-900">通用路線</h3>
  <div class="mt-4 grid gap-6 md:grid-cols-2">
    {
      general.map((p) => (
        <article class="rounded-3xl border border-sand-200 bg-white p-6 shadow-sm">
          <div class="flex items-baseline justify-between gap-3">
            <h4 class="text-xl font-bold text-banyan-900">{p.title}</h4>
            <span class="rounded-full bg-leaf-100 px-3 py-1 text-xs font-semibold text-leaf-700">
              {p.subtitle}
            </span>
          </div>
          <p class="mt-2 text-sm text-banyan-800/70">{p.audience}</p>

          <dl class="mt-3 grid grid-cols-3 gap-2 text-xs text-banyan-800/85">
            <div class="rounded-xl bg-sand-100/60 p-2 text-center">
              <dt class="text-banyan-800/60">總時間</dt>
              <dd class="font-semibold">{p.totalDuration}</dd>
            </div>
            <div class="rounded-xl bg-sand-100/60 p-2 text-center">
              <dt class="text-banyan-800/60">距離</dt>
              <dd class="font-semibold">{p.distance}</dd>
            </div>
            <div class="rounded-xl bg-sand-100/60 p-2 text-center">
              <dt class="text-banyan-800/60">體力</dt>
              <dd class="font-semibold">
                <span aria-hidden="true">
                  {"●".repeat(p.effort)}
                  {"○".repeat(5 - p.effort)}
                </span>
              </dd>
            </div>
          </dl>

          <p class="mt-3 text-sm leading-relaxed text-banyan-800/85">
            {p.summary}
          </p>

          <details class="mt-4 group">
            <summary class="cursor-pointer list-none text-sm font-semibold text-temple-700 hover:text-temple-800">
              行程明細 ({p.stops.length} 段)
            </summary>
            <ol class="mt-3 list-none space-y-2 p-0">
              {p.stops.map((s) => (
                <li class="flex gap-3 rounded-xl bg-sand-100/50 p-3 text-sm">
                  <span class="font-bold text-temple-700">{s.n}</span>
                  <div class="flex-1">
                    <p class="flex items-baseline justify-between gap-2 font-semibold text-banyan-900">
                      {s.title}
                      <span class="text-xs font-normal text-banyan-800/60">
                        {s.duration} 分
                      </span>
                    </p>
                    <p class="mt-1 text-xs leading-relaxed text-banyan-800/80">
                      {s.description}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </details>

          <details class="mt-2 group">
            <summary class="cursor-pointer list-none text-sm font-semibold text-temple-700 hover:text-temple-800">
              貼心提醒
            </summary>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-banyan-800/80 marker:text-leaf-400">
              {p.tips.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </details>
        </article>
      ))
    }
  </div>
</section>