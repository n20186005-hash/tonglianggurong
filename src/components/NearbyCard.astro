---
import { Image } from "astro:assets";
import type { NearbyPlace } from "../data/nearby";
interface Props {
  place: NearbyPlace;
}
const { place } = Astro.props;
---

<article
  class="group flex flex-col overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <div class="aspect-[4/3] overflow-hidden">
    {place.image ? <Image
      src={place.image}
      alt={place.alt}
      widths={[320, 480, 640]}
      sizes="(min-width: 768px) 30vw, 90vw"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    /> : <div class="flex h-full items-center justify-center bg-sand-100 p-5 text-center text-sm text-banyan-800">{place.name}<span class="sr-only">照片請至專屬地圖查看</span></div>}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="text-lg font-bold text-banyan-900">{place.name}</h3>
      <span class="text-xs font-medium text-leaf-500">{place.english}</span>
    </div>
    <p class="mt-1 text-xs font-semibold text-temple-700">
      {place.driveFromBanyan}
    </p>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-banyan-800/85">
      {place.summary}
    </p>
    <a href={`/attractions/${place.slug}/`} class="mt-4 text-sm font-bold text-temple-700 hover:underline">閱讀景點完整指南 →</a>
    <a
      href={place.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-banyan-900 hover:text-temple-700"
    >
      查看{place.name}的 Google 地圖
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
