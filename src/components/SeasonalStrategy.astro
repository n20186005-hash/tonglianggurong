---
/**
 * 季度遊覽策略
 *
 * 氣象、水文、人潮、節慶綜合分析
 * 資料主體：中央氣象署澎湖測站 30 年常年氣候統計
 */

import {
  seasonalMonths,
  seasonalSummary,
  scoreColor,
  scoreDots,
} from "../data/seasonal";
---

<section
  aria-labelledby="seasonal-title"
  class="mx-auto max-w-6xl px-4 py-16 md:px-6"
>
  <div class="mb-8 max-w-3xl">
    <p class="text-sm font-semibold tracking-wide text-temple-700">
      季度遊覽策略
    </p>
    <h2
      id="seasonal-title"
      class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl"
    >
      一年十二個月的氣象、水文與人潮綜合分析
    </h2>
    <p class="mt-3 text-base leading-relaxed text-banyan-800/85">
      資料主體參考中央氣象署澎湖測站常年氣候統計，並納入澎湖海域潮汐、海岸生態與在地節慶。
      「推薦指數」採氣溫、風速、降雨、人潮與生態觀察綜合評估，<strong
        >5 顆星最推薦，1 顆星表示條件較具挑戰性</strong
      >。
    </p>
  </div>

  <!-- 摘要圖例 -->
  <div class="mb-6 flex flex-wrap gap-3 text-sm">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-leaf-200 bg-leaf-100 px-3 py-1.5 text-leaf-700"
    >
      <span class="font-semibold">推薦</span>
      <span class="opacity-80">4–5 月、6 月</span>
    </span>
    <span
      class="inline-flex items-center gap-2 rounded-full border border-sand-200 bg-sand-100 px-3 py-1.5 text-temple-700"
    >
      <span class="font-semibold">次推薦</span>
      <span class="opacity-80">3 月、7 月、9–10 月</span>
    </span>
    <span
      class="inline-flex items-center gap-2 rounded-full border border-banyan-200 bg-banyan-100 px-3 py-1.5 text-banyan-700"
    >
      <span class="font-semibold">淡季</span>
      <span class="opacity-80">1–2 月、8 月、11–12 月</span>
    </span>
  </div>

  <!-- 月份卡片（桌機 4 欄、平板 3 欄、手機 2 欄）-->
  <ol
    class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 list-none p-0"
    aria-label="通樑古榕每月遊覽策略"
  >
    {
      seasonalMonths.map((m) => {
        const c = scoreColor(m.visitScore);
        return (
          <li
            class:list={[
              "rounded-2xl border bg-white p-5 shadow-sm",
              m.visitScore >= 4
                ? "border-leaf-200"
                : m.visitScore === 3
                  ? "border-sand-200"
                  : "border-banyan-200",
            ]}
          >
            <div class="flex items-baseline justify-between">
              <h3 class="text-lg font-bold text-banyan-900">{m.monthLabel}</h3>
              <span
                class:list={["rounded-full px-2 py-0.5 text-xs font-semibold", c.fill, c.text]}
              >
                {m.visitScore}/5
              </span>
            </div>
            <p
              class:list={["mt-1 text-sm", c.text]}
              aria-label={`推薦指數 ${m.visitScore} 顆星`}
            >
              <span aria-hidden="true">{scoreDots(m.visitScore)}</span>
            </p>
            <dl class="mt-3 grid grid-cols-2 gap-2 text-xs text-banyan-800/85">
              <div>
                <dt class="text-banyan-800/60">氣溫</dt>
                <dd class="font-semibold">
                  {m.avgLow}° / {m.avgHigh}°
                </dd>
              </div>
              <div>
                <dt class="text-banyan-800/60">降雨</dt>
                <dd class="font-semibold">
                  {m.rainfallMm} mm · {m.rainyDays} 日
                </dd>
              </div>
              <div>
                <dt class="text-banyan-800/60">風力</dt>
                <dd class="font-semibold">{m.windLevel}</dd>
              </div>
              <div>
                <dt class="text-banyan-800/60">海況</dt>
                <dd class="font-semibold">詳見表格</dd>
              </div>
            </dl>
            <p class="mt-3 text-xs leading-relaxed text-banyan-800/75">
              {m.recommendation}
            </p>
            <p class="mt-2 text-xs font-semibold text-temple-700">
              重點觀察
            </p>
            <ul class="mt-1 list-disc space-y-0.5 pl-4 text-xs text-banyan-800/75 marker:text-leaf-400">
              {m.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ol>

  <!-- 表格版（給詳細檢視者使用） -->
  <div class="mt-10 overflow-x-auto rounded-2xl border border-sand-200 bg-white">
    <table class="w-full min-w-[760px] text-left text-sm">
      <caption class="sr-only">
        通樑古榕全年月份氣象與遊覽建議總覽表
      </caption>
      <thead class="bg-sand-100/60 text-xs uppercase tracking-wide text-banyan-800/70">
        <tr>
          <th scope="col" class="px-4 py-3">月份</th>
          <th scope="col" class="px-4 py-3">氣溫 (°C)</th>
          <th scope="col" class="px-4 py-3">降雨 / 雨日</th>
          <th scope="col" class="px-4 py-3">風力</th>
          <th scope="col" class="px-4 py-3">海況</th>
          <th scope="col" class="px-4 py-3 text-center">推薦指數</th>
          <th scope="col" class="px-4 py-3">建議</th>
        </tr>
      </thead>
      <tbody>
        {
          seasonalMonths.map((m) => {
            const c = scoreColor(m.visitScore);
            return (
              <tr class="border-t border-sand-200 align-top">
                <th scope="row" class="px-4 py-3 font-bold text-banyan-900">
                  {m.monthLabel}
                </th>
                <td class="px-4 py-3 text-banyan-800/85">
                  {m.avgLow}–{m.avgHigh}
                </td>
                <td class="px-4 py-3 text-banyan-800/85">
                  {m.rainfallMm} mm · {m.rainyDays} 日
                </td>
                <td class="px-4 py-3 text-banyan-800/85">
                  {m.windLevel}（{m.avgWindMax} km/h）
                </td>
                <td class="px-4 py-3 text-banyan-800/85">{m.seaCondition}</td>
                <td class="px-4 py-3 text-center">
                  <span
                    class:list={[
                      "inline-block rounded-full px-3 py-1 text-xs font-semibold",
                      c.fill,
                      c.text,
                    ]}
                  >
                    {m.visitScore}/5
                  </span>
                </td>
                <td class="px-4 py-3 text-banyan-800/85">{m.recommendation}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs text-banyan-800/55">
    表格數值以中央氣象署澎湖測站常年氣候統計為主，實際感受受當年氣候、
    鋒面與颱風路徑影響可能有所差異。行前建議再次確認最新預報。
  </p>
</section>