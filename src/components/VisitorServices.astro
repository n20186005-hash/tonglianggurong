---
/**
 * 訪客服務與周邊設施（中立類型概述）
 *
 * - 呈現 WC、停車、餐飲、住宿、購物、加油、充電等使用者在意資訊
 * - 不推薦具體商家名稱，僅列類型與常見位置類型
 */

import { visitorServices, serviceIcon } from "../data/services";
---

<section
  aria-labelledby="services-title"
  class="mx-auto max-w-6xl px-4 py-16 md:px-6"
>
  <div class="mb-8 max-w-3xl">
    <p class="text-sm font-semibold tracking-wide text-temple-700">
      訪客服務與周邊設施
    </p>
    <h2
      id="services-title"
      class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl"
    >
      出發前要知道的實用資訊
    </h2>
    <p class="mt-3 text-base leading-relaxed text-banyan-800/85">
      本網站為非營利科普性質，<strong
        >僅列出服務類型與常見位置類型，不推薦特定商家</strong
      >。即時資訊請以 Google Maps、澎湖國家風景區管理處公告為準。
    </p>
  </div>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
    {
      visitorServices.map((s) => {
        const icon = serviceIcon(s.icon);
        return (
          <li class="rounded-3xl border border-sand-200 bg-white p-6 shadow-sm">
            <div class="flex items-start gap-3">
              <span
                class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-leaf-100 text-leaf-700"
                aria-hidden="true"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path
                    d={icon.path}
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <div>
                <h3 class="text-lg font-bold text-banyan-900">{s.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-banyan-800/80">
                  {s.summary}
                </p>
              </div>
            </div>
            <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-banyan-800/75 marker:text-leaf-400">
              {s.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-banyan-800/55">
              常見位置類型
            </p>
            <ul class="mt-1 flex flex-wrap gap-2 list-none p-0">
              {
                s.locations.map((l) => (
                  <li class="rounded-full bg-sand-100 px-3 py-1 text-xs text-banyan-800/80">
                    {l}
                  </li>
                ))
              }
            </ul>
          </li>
        );
      })
    }
  </ul>
</section>