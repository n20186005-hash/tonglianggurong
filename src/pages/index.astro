---
export const prerender = false;

import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GoogleMap from "../components/GoogleMap.astro";
import FAQList from "../components/FAQList.astro";
import NearbyCard from "../components/NearbyCard.astro";
import WeatherWidget from "../components/WeatherWidget.astro";
import SeasonalStrategy from "../components/SeasonalStrategy.astro";
import ItineraryPlans from "../components/ItineraryPlans.astro";
import VisitorServices from "../components/VisitorServices.astro";
import ScienceEducation from "../components/ScienceEducation.astro";
import { place, site } from "../data/place";
import { images } from "../data/images";
import { mainNav } from "../data/navigation";
import { nearbyPlaces } from "../data/nearby";
import { faqItems, faqSchema } from "../data/faq";
import { getWeatherSnapshot } from "../utils/weather";

const homeFaq = faqItems.slice(0, 6);

// 伺服器端抓取即時天氣與七日預報，使用 Cache API 於 Cloudflare Workers 邊緣節點快取 30 分鐘
// 注意：前端頁面「不顯示」任何介接服務資訊（依需求）
let weatherSnapshot: Awaited<ReturnType<typeof getWeatherSnapshot>> | null =
  null;
try {
  const cache = (globalThis as { caches?: Cache }).caches;
  weatherSnapshot = await getWeatherSnapshot(cache);
} catch (err) {
  // 即使天氣抓取失敗，首頁其他內容仍照常呈現；氣象區塊將不顯示
  console.error("[weather] snapshot failed:", (err as Error).message);
}

// TouristAttraction JSON-LD：綁定 SEO 實體
// 注意：評論 / 評分只在前端顯示，不進入結構化資料 aggregateRating，
// 以避免 Google 判定違反用戶原創內容政策。
const touristSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "@id": `${site.url}/#attraction`,
  name: place.name,
  alternateName: [
    ...place.alternateNames,
    `${place.cityName} ${place.name}`,
    `${place.officialEnglishName} ${place.cityNameEn}`,
  ],
  description:
    `Comprehensive visitor guide to ${place.officialEnglishName} (${place.name}) in ${place.cityName}, ${place.stateProvince}, ${place.countryNameEn}. ` +
    `View location map, opening details, nearby Penghu Great Bridge, and travel tips.`,
  url: site.url + "/",
  telephone: place.phone,
  inLanguage: "zh-Hant-TW",
  image: [
    `${site.url}/og/tongliang-gurong.jpg`,
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    "@type": "PostalAddress",
    streetAddress: place.addressParts.streetAddress,
    addressLocality: place.addressParts.addressLocality,
    addressRegion: place.addressParts.addressRegion,
    postalCode: place.postalCode,
    addressCountry: place.addressParts.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: place.coordinates.latitude,
    longitude: place.coordinates.longitude,
  },
  hasMap: place.mapsShareUrl,
  sameAs: [
    place.mapsShareUrl,
    place.googleMapsUrl,
    place.govtTourismUrl,
    place.penghuNsaUrl,
  ],
  touristType: ["自由行", "親子", "長輩", "攝影", "機車旅行"],
  containedInPlace: {
    "@type": "AdministrativeArea",
    name: `${place.stateProvince}, ${place.countryNameEn}`,
  },
  additionalType: "https://schema.org/PlaceOfWorship",
};

const facts = [
  { label: "位置", value: "澎湖縣白沙鄉通樑村" },
  { label: "類型", value: "古樹、廟宇、村落文化" },
  { label: "特色", value: "約 95 根氣根形成單木成林" },
  { label: "建議搭配", value: "澎湖跨海大橋與北環路線" },
];

const reasons = [
  {
    title: "一棵樹形成一片綠蔭",
    body: "氣根落地後逐漸增粗成為支柱根，看起來像許多棵樹，其實源自同一株古榕，撐起約 660 平方公尺的樹蔭空間。",
    image: images.banyanTrunk,
    alt: `${place.officialEnglishName} - ${place.shortName} 主幹與支柱根 Main view in ${place.cityName}, ${place.countryNameEn}`,
  },
  {
    title: "古樹與廟宇共生",
    body: "古榕枝幹、通樑保安宮的朱紅屋脊、廟埕與居民生活交織在一起，是澎湖少見的人文與自然共構空間。",
    image: images.banyanTempleSign,
    alt: `${place.officialEnglishName} 與通樑保安宮廟牌 Baoan Temple near ${place.shortName}`,
  },
  {
    title: "北環途中最舒適的休息點",
    body: "濃密樹蔭適合避開澎湖烈日，吃一支仙人掌冰、拍照，再前往一橋之隔的跨海大橋，是北環最自然的中繼站。",
    image: images.heroTempleBanyanAerial,
    alt: `${place.officialEnglishName} 與通樑村空拍全景 ${place.shortName} in ${place.cityName}`,
  },
];

const firstVisit = [
  { n: "01", title: "氣根形成的天然長廊", text: "支柱根與棚架撐起低垂樹冠，形成可以走進去的綠色廊道。" },
  { n: "02", title: "樹冠下的斑駁光影", text: "陽光穿過層層榕葉灑落地面，是最耐看的細節。" },
  { n: "03", title: "古榕與保安宮屋頂", text: "廟宇燕尾脊與翠綠榕葉同框，展現澎湖廟宇文化。" },
  { n: "04", title: "主幹、支柱根與人工支撐", text: "觀察哪些是自然落地的氣根、哪些是後來架設的支撐。" },
];

const routeStops = [
  "馬公", "中屯", "通樑古榕", "澎湖跨海大橋", "小門鯨魚洞", "二崁聚落", "大菓葉柱狀玄武岩", "漁翁島燈塔",
];
---

<BaseLayout
  title={`通樑古榕（通梁古榕）｜免費參觀、交通停車與澎湖攻略`}
  description={`通樑古榕（通梁古榕，Tongliang Great Banyan）位於澎湖縣白沙鄉通樑保安宮前，全天開放、免門票。整理從馬公出發的交通停車、古榕氣根、拍照位置、附近美食與跨海大橋北環行程。`}
  path="/"
  schema={[touristSchema, faqSchema(homeFaq)]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-banyan-950 text-sand-50">
    <Image
      src={images.banyanCanopyTall}
      alt={`${place.officialEnglishName} - ${place.shortName} 氣根形成的樹蔭長廊 Main view in ${place.cityName}, ${place.countryNameEn}`}
      widths={[480, 768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[center_52%]"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-banyan-950 via-banyan-950/75 to-banyan-950/40"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 py-24 md:px-6 md:py-36">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-[0.3em] text-leaf-300 uppercase">
          {place.stateProvince} · {place.cityName}通樑村
        </p>
        <h1 class="mt-4 text-5xl font-bold tracking-tight md:text-7xl">
          {place.name}（{place.officialEnglishName}｜通梁古榕）· {place.cityName}
        </h1>
        <p class="mt-3 text-sm font-semibold tracking-[0.25em] text-leaf-300/85 uppercase">
          {place.shortName} · 白沙鄉 · 澎湖 · 台灣
        </p>
        <p class="mt-6 text-2xl font-semibold text-sand-50 md:text-3xl">
          {place.tagline}
        </p>
        <!-- 4.1 首段等位聲明：將網域語義（短稱）等同於官方全稱 -->
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-sand-100/85">
          <strong class="font-bold text-sand-50">{place.name}</strong>（英文名稱：{place.officialEnglishName}，亦稱通梁古榕）
          位於臺灣<strong class="font-bold text-sand-50">{place.stateProvince}{place.cityName}</strong>通樑村，
          是澎湖北環最具代表性的古樹景點之一。老榕與保安宮相伴，讓旅客在濃密樹蔭下認識地方信仰與村落生活。
        </p>
        <!-- 4.3 週邊語義集群描述：核心地標 1 / 2 -->
        <p class="mt-3 max-w-xl text-base leading-relaxed text-sand-100/80">
          參觀古榕後，可順路探索附近的
          <strong class="font-semibold text-sand-50">澎湖跨海大橋（Penghu Great Bridge）</strong>
          與<strong class="font-semibold text-sand-50">通樑保安宮（Baoan Temple）</strong>，再前往西嶼海岸地景。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={place.directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-sand-50 px-6 py-3.5 font-semibold text-banyan-950 transition-colors hover:bg-sand-100"
          >
            在 Google Maps 導航
          </a>
          <a
            href="/north-loop-itinerary/"
            class="inline-flex items-center gap-2 rounded-full border border-sand-100/40 px-6 py-3.5 font-semibold text-sand-50 transition-colors hover:bg-sand-50/10"
          >
            查看北環行程
          </a>
        </div>

        <!-- 首屏關鍵資訊（免費、開放時間、停留、所在地） -->
        <dl class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="rounded-2xl bg-sand-50/10 px-4 py-3 backdrop-blur-sm">
            <dt class="text-xs font-semibold tracking-wide text-leaf-300">門票</dt>
            <dd class="mt-1 text-base font-bold text-sand-50">免費參觀</dd>
          </div>
          <div class="rounded-2xl bg-sand-50/10 px-4 py-3 backdrop-blur-sm">
            <dt class="text-xs font-semibold tracking-wide text-leaf-300">開放時間</dt>
            <dd class="mt-1 text-base font-bold text-sand-50">全天開放</dd>
          </div>
          <div class="rounded-2xl bg-sand-50/10 px-4 py-3 backdrop-blur-sm">
            <dt class="text-xs font-semibold tracking-wide text-leaf-300">建議停留</dt>
            <dd class="mt-1 text-base font-bold text-sand-50">20–40 分鐘</dd>
          </div>
          <div class="rounded-2xl bg-sand-50/10 px-4 py-3 backdrop-blur-sm">
            <dt class="text-xs font-semibold tracking-wide text-leaf-300">所在地</dt>
            <dd class="mt-1 text-base font-bold text-sand-50">澎湖縣白沙鄉</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 快速認識 -->
  <section aria-labelledby="facts-title" class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <h2 id="facts-title" class="sr-only">快速認識{place.name}</h2>
    <dl class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        facts.map((f) => (
          <div class="rounded-2xl border border-sand-200 bg-white p-5">
            <dt class="text-sm font-semibold text-temple-700">{f.label}</dt>
            <dd class="mt-2 text-base font-medium text-banyan-900">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- About Tongliang Great Banyan（H2 語義結構）-->
  <section aria-labelledby="about-title" class="mx-auto max-w-3xl px-4 md:px-6">
    <h2 id="about-title" class="text-3xl font-bold text-banyan-900 md:text-4xl">
      關於通樑古榕（{place.officialEnglishName}）
    </h2>
    <div class="mt-5 space-y-5 text-lg leading-relaxed text-banyan-800/85">
      <p>
        <strong>{place.officialEnglishName}</strong>（中文：<strong>{place.name}</strong>，亦作
        <strong>通梁古榕</strong>，又稱
        <strong>{place.shortName}</strong>）位於 <strong>{place.cityName}</strong>，
        <strong>{place.stateProvince}</strong>，<strong>{place.countryName}</strong>，是澎湖北環最具代表性的自然人文地標。
        不論你搜尋「通樑古榕」或「通梁古榕」，指的都是這棵位在通樑保安宮前的老榕樹。
      </p>
      <p>
        這株被稱為「<strong>通樑古榕</strong>（通梁古榕）」的老榕樹以約 95 根氣根撐起約 660 平方公尺的綠蔭，
        與一旁的 <strong>通樑保安宮（澎湖保安宮）</strong> 共生數百年，是澎湖白沙鄉通樑村的信仰與生活中心。
      </p>
      <h3 class="pt-2 text-xl font-bold text-banyan-900">古榕的由來</h3>
      <p>
        通樑保安宮主祀廣澤尊王（又稱郭聖王），相傳由清朝年間泉州同安移民奉請而來。廟方沿革指出，保安宮建廟之時，
        廟埕前已有一棵老榕，地方耆老推測古榕的樹齡至少與廟宇相當，因此「<strong>廟與樹共生</strong>」並非後人附會的浪漫說法，
        而是通樑村數代人共同的生活記憶。
      </p>
      <h3 class="pt-2 text-xl font-bold text-banyan-900">地名「通樑」的由來</h3>
      <p>
        「<strong>通樑</strong>」地名源自清代金龍橋（古稱「通梁橋」）的所在地，後因橋樑與聚落緊密相依而得名。
        由於該區海岸線多見紅色砂岩，當地居民另稱「<strong>紅毛城</strong>」以形容赭紅色岩石遍布的地貌。
        如今通樑聚落以保安宮為中心，古榕、跨海大橋與白沙海岸線共同構成通樑村的識別符號。
      </p>
      <h3 class="pt-2 text-xl font-bold text-banyan-900">樹齡爭議：200 年還是 300 年？</h3>
      <p>
        由於缺乏精確的種植紀錄，關於<strong>{place.name}</strong>的樹齡有「200 多年」與「超過 300 年」兩種說法。
        地方耆老與部分文史資料以前者為主，而遊客口耳相傳的「三百年老榕」則屬後人浪漫化推測。
        本站依循<strong>科學立場</strong>將此列為「地方傳說與歷史推測」，不採用任一數字作為確定資訊。
      </p>
      <h3 class="pt-2 text-xl font-bold text-banyan-900">一棵樹的科學</h3>
      <p>
        從生物學角度，<strong>{place.name}</strong>展示的是熱帶至亞熱帶海岸常見的「<strong>獨木成林</strong>」策略：
        母樹的枝條向下伸出氣根，氣根落地後逐漸木質化並增粗，最終形成能承重的「<strong>支柱根</strong>」，
        讓樹冠得以向四面八方擴張。古榕估計約 95 根支柱根撐起的傘狀樹冠覆蓋約 660 平方公尺，
        是台灣西部海岸少數能近距離走入的「<strong>森林級榕樹</strong>」。
      </p>
      <p class="text-sm text-banyan-800/65">
        地理歸屬：{place.name} → {place.cityName} → {place.stateProvince} → {place.countryName}
      </p>
    </div>
  </section>

  <!-- 為什麼值得去 -->
  <section aria-labelledby="why-title" class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="mb-10 max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-temple-700">為什麼值得去</p>
      <h2 id="why-title" class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl">
        走進古榕樹蔭下
      </h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        reasons.map((r) => (
          <article class="overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-sm">
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={r.image}
                alt={r.alt}
                widths={[360, 540, 720]}
                sizes="(min-width: 768px) 30vw, 90vw"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-banyan-900">{r.title}</h3>
              <p class="mt-3 leading-relaxed text-banyan-800/85">{r.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Location & How to Visit（H2 語義結構）-->
  <section aria-labelledby="visit-title" class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 id="visit-title" class="text-3xl font-bold text-banyan-900 md:text-4xl">
      通樑古榕在哪裡？交通與參觀方式
    </h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-banyan-800/85">
      通樑古榕位於澎湖縣白沙鄉通樑村，緊鄰澎湖跨海大橋白沙端橋頭。
      從馬公出發可沿縣道 203 騎車或開車前往，依通樑保安宮及古榕指標抵達；停車後可步行參觀古榕與廟埕。
    </p>
  </section>

  <!-- Landmarks & Attractions Around（H2 語義結構）-->
  <section aria-labelledby="landmarks-title" class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 id="landmarks-title" class="text-3xl font-bold text-banyan-900 md:text-4xl">
      通樑古榕周邊地標與景點
    </h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-banyan-800/85">
      通樑古榕旁就是<strong>通樑保安宮（Baoan Temple）</strong>，
      從此處前往<strong>澎湖跨海大橋（Penghu Great Bridge）</strong>橋頭約需一分鐘車程。
      過橋後可依序遊覽小門鯨魚洞、二崁聚落、柱狀玄武岩與漁翁島燈塔。
    </p>
  </section>

  <!-- 第一次來看什麼 -->
  <section aria-labelledby="first-title" class="bg-sand-100/60">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6">
      <div class="mb-10 max-w-2xl">
        <p class="text-sm font-semibold tracking-wide text-temple-700">第一次來看什麼</p>
        <h2 id="first-title" class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl">
          四個不能錯過的細節
        </h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          firstVisit.map((c) => (
            <div class="rounded-3xl border border-sand-200 bg-white p-6">
              <span class="text-3xl font-bold text-leaf-300">{c.n}</span>
              <h3 class="mt-3 text-lg font-bold text-banyan-900">{c.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-banyan-800/80">{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- History & Significance of（H2 語義結構）-->
  <section aria-labelledby="history-title" class="mx-auto max-w-3xl px-4 py-12 md:px-6">
    <h2 id="history-title" class="text-3xl font-bold text-banyan-900 md:text-4xl">
      通樑古榕的歷史與文化意義
    </h2>
    <p class="mt-4 leading-relaxed text-banyan-800/85">
      地方傳說記載樹齡超過 300 年，部分資料則為 200 多年，皆屬「地方傳說與歷史推測」；
      唯一可確定的是：<strong>{place.name}</strong> 與 <strong>通樑保安宮</strong>
      長年共生，已成為通樑村不可分割的一部分。
    </p>
  </section>

  <!-- 即時氣象 + 七日預報（伺服器端抓取，前端不顯示介接服務資訊） -->
  {weatherSnapshot && <WeatherWidget snapshot={weatherSnapshot} />}

  <!-- 季度遊覽策略 -->
  <div class="bg-sand-100/40">
    <SeasonalStrategy />
  </div>

  <!-- 深入了解（內部連結） -->
  <section aria-labelledby="explore-title" class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="mb-10 max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-temple-700">深入了解</p>
      <h2 id="explore-title" class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl">
        規劃你的{place.name}之旅
      </h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class="group rounded-2xl border border-sand-200 bg-white p-5 transition-colors hover:border-banyan-700"
          >
            <h3 class="flex items-center justify-between text-lg font-bold text-banyan-900">
              {item.label}
              <span class="text-leaf-500 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </h3>
            <p class="mt-2 text-sm text-banyan-800/75">{item.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Google Maps（含評價區塊） -->
  <GoogleMap />

  <!-- 按人群定制的遊覽方案 -->
  <div class="bg-sand-100/40">
    <ItineraryPlans />
  </div>

  <!-- 訪客服務與周邊設施（中立類型概述） -->
  <VisitorServices />

  <!-- 權威外部連結（官方觀光局） -->
  <section aria-labelledby="official-title" class="mx-auto max-w-3xl px-4 pb-12 md:px-6">
    <h2 id="official-title" class="sr-only">官方旅遊資訊</h2>
    <p class="text-sm leading-relaxed text-banyan-800/85">
      參觀前如需核對官方景點資料、交通或最新公告，請參考
      <a
        href={place.govtTourismUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-temple-700 underline"
        >交通部觀光署官方旅遊資訊</a
      >.
    </p>
  </section>

  <!-- 北環路線簡版 -->
  <section aria-labelledby="route-title" class="bg-banyan-950 text-sand-50">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6">
      <div class="mb-8 max-w-2xl">
        <p class="text-sm font-semibold tracking-wide text-leaf-300">澎湖北環路線</p>
        <h2 id="route-title" class="mt-2 text-3xl font-bold md:text-4xl">
          從馬公一路玩到漁翁島
        </h2>
        <p class="mt-3 text-sand-100/85">
          {place.name}是北環路線上最自然的休息點，串連跨海大橋與整條西嶼海岸。
        </p>
      </div>
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-3 text-sm md:text-base">
        {
          routeStops.map((stop, i) => (
            <li class="flex items-center gap-2">
              <span
                class:list={[
                  "rounded-full px-4 py-2 font-medium",
                  stop === "通樑古榕"
                    ? "bg-sand-50 text-banyan-950 font-bold"
                    : "bg-banyan-900/70 text-sand-100",
                ]}
              >
                {stop}
              </span>
              {i < routeStops.length - 1 && (
                <span class="text-leaf-300" aria-hidden="true">→</span>
              )}
            </li>
          ))
        }
      </ol>
      <a
        href="/north-loop-itinerary/"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-sand-50 px-6 py-3 font-semibold text-banyan-950 hover:bg-sand-100"
      >
        查看完整北環一日行程 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- 附近景點 -->
  <section aria-labelledby="nearby-title" class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="mb-10 max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-temple-700">附近景點</p>
      <h2 id="nearby-title" class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl">
        跨海大橋與西嶼沿線
      </h2>
      <p class="mt-4 leading-relaxed text-banyan-800/85">從古榕旁的跨海大橋出發，沿北環探訪海蝕拱門、傳統聚落、柱狀玄武岩與歷史燈塔。選擇景點可閱讀歷史、交通、拍照及現場參觀重點。</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {nearbyPlaces.map((p) => <NearbyCard place={p} />)}
    </div>
    <a
      href="/nearby-attractions/"
      class="mt-8 inline-flex items-center gap-2 font-semibold text-banyan-900 hover:text-temple-700"
    >
      查看全部附近景點 <span aria-hidden="true">→</span>
    </a>
  </section>

  <!-- 科普與訪客責任（緊接 FAQ 之前） -->
  <div class="bg-sand-100/30">
    <ScienceEducation />
  </div>

  <!-- FAQ -->
  <section aria-labelledby="faq-title" class="bg-sand-100/60">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6">
      <div class="mb-8 text-center">
        <p class="text-sm font-semibold tracking-wide text-temple-700">常見問題</p>
        <h2 id="faq-title" class="mt-2 text-3xl font-bold text-banyan-900 md:text-4xl">
          出發前想知道的事
        </h2>
      </div>
      <FAQList items={homeFaq} />
      <div class="mt-8 text-center">
        <a href="/faq/" class="font-semibold text-banyan-900 hover:text-temple-700">
          查看全部常見問題 →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
