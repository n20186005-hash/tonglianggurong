---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import NearbyCard from "../components/NearbyCard.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { nearbyPlaces } from "../data/nearby";

const breadcrumbs = [
  { name: "首頁", path: "/" },
  { name: "附近景點", path: "/nearby-attractions/" },
];
---

<BaseLayout
  title="通樑古榕附近景點｜澎湖北環 8 大景點完整指南與路線"
  description="通樑古榕附近景點整理：跨海大橋、鯨魚洞、柱狀玄武岩、二崁聚落、池西岩瀑、漁翁島燈塔、西嶼西臺與東臺古堡，附獨立指南及 Google Maps。"
  path="/nearby-attractions/"
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    eyebrow="周邊景點"
    title="通樑古榕（通梁古榕）附近景點"
    subtitle="從跨海大橋、鯨魚洞、玄武岩到兩座歷史砲臺，探索西嶼北環的自然與人文風景。"
    breadcrumbs={breadcrumbs}
  />

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <p class="mb-10 max-w-2xl text-lg leading-relaxed text-banyan-800/85">
      本頁介紹<strong>通樑古榕（通梁古榕）</strong>周邊 8 個獨立景點。前六站以跨海大橋、西嶼地質與聚落的經典北環路線為核心；
      另收錄<strong class="text-banyan-900">西嶼西臺與東臺古堡</strong>兩處軍事古蹟。建議依當天開放狀況選擇路線，不必為了集滿景點往返折返。
    </p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {nearbyPlaces.map((p) => <NearbyCard place={p} />)}
    </div>
    <p class="mt-8 max-w-3xl text-sm leading-relaxed text-banyan-800/80">每個景點都有獨立的文化或地質介紹、參觀重點、拍攝建議與專屬地圖入口。以下行車時間為行程規劃概估，實際請依交通與天候調整。</p>
  </section>

  <RelatedLinks
    title="把景點串成行程"
    links={[
      { label: "澎湖北環一日行程", href: "/north-loop-itinerary/", desc: "完整走完西嶼" },
      { label: "北環半日行程", href: "/half-day-itinerary/", desc: "時間有限的精選" },
      { label: "交通與停車", href: "/transportation/", desc: "怎麼到、怎麼停" },
      { label: "美食補給", href: "/food/", desc: "沿線吃什麼" },
    ]}
  />
</BaseLayout>
