---
export const prerender = true;

import ArticleLayout from "../layouts/ArticleLayout.astro";
import Figure from "../components/Figure.astro";
import Callout from "../components/Callout.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { images } from "../data/images";
import { place } from "../data/place";
---

<ArticleLayout
  title="通樑古榕（通梁古榕）參觀指南｜值不值得去、停留多久、怎麼逛"
  eyebrow="Visitor Guide"
  subtitle="本頁介紹通樑古榕（通梁古榕）的參觀指南：門票、開放時間、建議停留時間、逛法路線與人潮時段建議。"
  description="通樑古榕（通梁古榕）參觀指南：免費參觀、24小時開放、建議停留 20–40 分鐘、最佳拍照時機清晨與傍晚、人潮尖峰中午前後、無障礙動線與參觀禮儀說明。"
  path="/visitor-guide/"
  ogImage="/og/tongliang-gurong.jpg"
>
  <p>
    本頁介紹<strong>通樑古榕（通梁古榕，{place.officialEnglishName}，又稱{place.shortName}）</strong>的參觀指南，包含值不值得去、停留多久、怎麼逛、人潮時機與基本參觀禮儀。它位於澎湖縣白沙鄉通樑村通樑保安宮前，免費參觀、24 小時開放，是北環路線上最經典的中途休息與拍照點；不論你搜尋「通樑古榕」或「通梁古榕」的「參觀建議」，這頁都有對應的資訊。
  </p>

  <h2>基本資訊：門票、開放時間、建議停留</h2>
  <ul>
    <li><strong>門票：</strong>免費參觀，無需購票。</li>
    <li><strong>開放時間：</strong>通樑保安宮廟埕與樹蔭廣場為戶外開放空間，<strong>24 小時開放</strong>；保安宮本殿開放時間以廟方公告為準，通常為清晨至晚間。</li>
    <li><strong>建議停留時間：</strong>一般觀光拍照約 <strong>20–30 分鐘</strong>；若要深度觀察支柱根、氣根與建築細節，建議預留 <strong>40 分鐘至 1 小時</strong>。</li>
    <li><strong>無障礙動線：</strong>廟埕與樹蔭廣場大部分為平坦鋪面，輪椅與娃娃車可通行；部分支柱根下方地面略有起伏，陪同者可協助留意。</li>
  </ul>

  <Figure
    src={images.banyanFront}
    alt={`${place.officialEnglishName} - 從通樑古榕前望向通樑漁港 全景`}
    caption="從通樑古榕（通梁古榕）樹蔭邊望向通樑漁港，南側堤岸為順路散步區域。"
  />

  <h2>怎麼逛最順：三種節奏</h2>
  <ol>
    <li><strong>快速經典（20 分鐘）：</strong>廟埕 → 樹冠入口仰拍 → 走進氣根支柱根長廊 → 保安宮燕尾屋脊與榕葉同框 → 出發下一站。</li>
    <li><strong>標準觀光（40 分鐘）：</strong>快速經典路線 + 吃一支仙人掌冰 → 走到樹冠邊緣望向通樑漁港 → 跨過台 203 線看跨海大橋拱門。</li>
    <li><strong>深度觀察（1 小時以上）：</strong>標準觀光路線 + 分辨支柱根 vs 人工棚架 + 觀察樹冠生物多樣性（鳥類、昆蟲、附生植物） + 走訪附近紅毛城紅色砂岩。</li>
  </ol>

  <Callout title="最佳造訪時機" tone="leaf">
    <p>
      <strong>清晨與傍晚</strong>光線最柔和、氣溫較舒適，也能拍到光影穿過葉隙的效果；<strong>中午前後（11:00–14:00）</strong>為人潮尖峰，想拍無人的畫面建議避開。夏季正午樹蔭下仍相對涼爽，是北環騎車途中最佳休息點。
    </p>
  </Callout>

  <h2>參觀禮儀與小提醒</h2>
  <ul>
    <li>通樑保安宮為村民信仰中心，進入廟埕請維持基本禮貌，避免大聲喧嘩、奔跑。</li>
    <li>請勿拉扯、踐踏氣根與支柱根，也不要攀爬樹幹或在樹上留字——這株老樹是澎湖珍貴的自然文化資產。</li>
    <li>樹蔭廣場為共用空間，垃圾請自行帶走或投入垃圾桶，共同維護環境整潔。</li>
    <li>祭拜神明若有個人習慣，可隨緣參拜；如無祭拜意願，單純參觀樹木與建築也沒有問題。</li>
  </ul>

  <Callout title="雨天與強風因應" tone="sea">
    <p>
      通樑古榕（通梁古榕）的樹冠密集，<strong>小雨時樹下仍可短暫停留</strong>；但中到大雨、颱風季或東北季風特強時（風力 7 級以上），建議避免停留，尤其是跨海大橋路段風勢會更強。最新天氣預測與風速可參考本站即時天氣模組。
    </p>
  </Callout>

  <div slot="after">
    <RelatedLinks
      links={[
        { label: "交通與停車", href: "/transportation/", desc: "怎麼到、怎麼停" },
        { label: "拍照指南", href: "/photo-guide/", desc: "六個必拍機位" },
        { label: "北環一日行程", href: "/north-loop-itinerary/", desc: "串完整條路線" },
        { label: "美食補給", href: "/food/", desc: "仙人掌冰與小吃" },
      ]}
    />
  </div>
</ArticleLayout>