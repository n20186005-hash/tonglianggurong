{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tongliang-gurong",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 50
  },
  "vars": {
    "SITE_ENV": "production"
  }
}